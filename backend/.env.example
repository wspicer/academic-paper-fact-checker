# --- Paper search ---
OPENALEX_API_KEY=            # free at openalex.org/settings/api (needed)
S2_API_KEY=                  # optional, semanticscholar.org/product/api

# --- Who pays for the AI ---
# Users can bring their own Anthropic or OpenAI key in the extension settings.
# Optionally fund a small free tier with your own Anthropic key:
ANTHROPIC_API_KEY=           # leave blank for "bring your own key only"
FREE_CHECKS_PER_DAY=3        # per user (install + IP)
FREE_CHECKS_GLOBAL_PER_DAY=200   # total free checks per day across everyone (cost cap)
BYOK_CHECKS_PER_DAY=300      # per user, protects the server even with their own key

# --- Optional ---
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-5.6-sol
OPENAI_API_KEY=              # server-side speech-to-text for users without an OpenAI key
API_TOKEN=                   # set only to make the server private
MAX_VIDEO_MINUTES=45
